OPENWEATHER_API_KEY=openweather_api_key_here
AQICN_API_KEY=yaqicn_token_here

# Logging level: DEBUG, INFO, WARNING, ERROR (default: INFO)
LOG_LEVEL=INFO

# Storage backend: local (filesystem) or minio
STORAGE_BACKEND=minio

# Local filesystem base (used when STORAGE_BACKEND=local)
DATA_BASE_PATH=./data

# MinIO / S3-compatible storage (used when STORAGE_BACKEND=minio)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=weather-etl
MINIO_SECURE=false

# Request timeout in seconds (default: 30)
REQUEST_TIMEOUT=30
# Maximum retry attempts for failed requests (default: 3)
MAX_RETRIES=3

# MongoDB Configuration
# From your PC (Compass): use port 27018 — Docker maps host 27018 -> container 27017
MONGODB_HOST=localhost
MONGODB_PORT=27018
MONGODB_DATABASE=weather_etl
MONGODB_USERNAME=weather_user
MONGODB_PASSWORD=weather_pass
MONGODB_AUTH_SOURCE=weather_etl

# Local timezone for hour alignment (French cities)
LOCAL_TIMEZONE=Europe/Paris

# Optional: full URI overrides the settings above
# MONGODB_URI=mongodb://weather_user:weather_pass@localhost:27017/weather_etl?authSource=weather_etl

# Jupyter Lab (docker compose service `jupyter`) — http://localhost:8888
# Notebooks live under MachineLearning/notebooks/
