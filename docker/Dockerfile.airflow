FROM apache/airflow:2.10.2-python3.11

USER root
RUN apt-get update && apt-get install -y --no-install-recommends build-essential && rm -rf /var/lib/apt/lists/*
USER airflow

# Install project dependencies so DAG tasks can import/run existing pipeline modules.
COPY requirements.txt /tmp/requirements-project.txt
RUN pip install --no-cache-dir -r /tmp/requirements-project.txt
RUN pip install --no-cache-dir apache-airflow-providers-amazon
